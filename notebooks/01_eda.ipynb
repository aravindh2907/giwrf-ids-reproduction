# Exploratory Data Analysis for UNSW-NB15

This notebook verifies the swapped train/test filenames and confirms label distribution and attack category coverage against the paper.
</VSCode.Cell>
<VSCode.Cell language="python">
import pandas as pd

# NOTE: filenames are swapped relative to their content - verified via
# row count and class distribution match against the paper (Disha & Waheed 2022).
train = pd.read_csv("../data/raw/UNSW_NB15_testing-set.csv")   # actually TRAIN (175,341 rows)
test = pd.read_csv("../data/raw/UNSW_NB15_training-set.csv")   # actually TEST (82,332 rows)

print("Train shape:", train.shape)   # expect (175341, 45)
print("Test shape:", test.shape)     # expect (82332, 45)
</VSCode.Cell>
<VSCode.Cell language="python">
train_dist = train["label"].value_counts(normalize=True) * 100
test_dist = test["label"].value_counts(normalize=True) * 100
print("Train label distribution (%):\n", train_dist)
print("\nExpected from paper Fig.2: label=1 (attack) ~68.1%, label=0 (normal) ~31.9%")
print("\nTest label distribution (%):\n", test_dist)
print("\nExpected from paper Fig.3: label=1 (attack) ~55.1%, label=0 (normal) ~44.9%")
</VSCode.Cell>
<VSCode.Cell language="python">
print("Train attack_cat categories:", sorted(train["attack_cat"].unique()))
print("Test attack_cat categories:", sorted(test["attack_cat"].unique()))
print("Number of unique categories - train:", train["attack_cat"].nunique(), "test:", test["attack_cat"].nunique())
</VSCode.Cell>
<VSCode.Cell language="python">
import os
import matplotlib.pyplot as plt

os.makedirs("../results/figures", exist_ok=True)

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

train_counts = train["label"].value_counts().sort_index()
axes[0].pie(train_counts, labels=["Normal (0)", "Attack (1)"], autopct="%1.1f%%",
            colors=["green", "orange"], startangle=90)
axes[0].set_title("Transaction class distribution - UNSW-NB15 Train Dataset")

test_counts = test["label"].value_counts().sort_index()
axes[1].pie(test_counts, labels=["Normal (0)", "Attack (1)"], autopct="%1.1f%%",
            colors=["green", "orange"], startangle=90)
axes[1].set_title("Transaction class distribution - UNSW-NB15 Test Dataset")

plt.tight_layout()
plt.savefig("../results/figures/fig2_fig3_class_distribution.png", dpi=150)
plt.show()
</VSCode.Cell>
<VSCode.Cell language="python">
import os
import matplotlib.pyplot as plt

os.makedirs("../results/figures", exist_ok=True)

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

train_cat_order = train["attack_cat"].value_counts().index
target_train = train["attack_cat"].value_counts().loc[train_cat_order]
target_train.plot(kind="bar", ax=axes[0], color="steelblue")
axes[0].set_title("Distribution of categories - UNSW-NB15 Train Dataset")
axes[0].set_xlabel("Class")
axes[0].set_ylabel("Frequency")

train_test_order = [c for c in train_cat_order if c in test["attack_cat"].unique()]
test["attack_cat"].value_counts().loc[train_test_order].plot(kind="bar", ax=axes[1], color="steelblue")
axes[1].set_title("Distribution of categories - UNSW-NB15 Test Dataset")
axes[1].set_xlabel("Class")
axes[1].set_ylabel("Frequency")

plt.tight_layout()
plt.savefig("../results/figures/fig4_attack_categories.png", dpi=150)
plt.show()
</VSCode.Cell>
<VSCode.Cell language="python">
def infer_format(col):
    if train[col].dtype == "object":
        return "Categorical"
    elif train[col].dtype in ["int64"]:
        if train[col].nunique() == 2:
            return "Binary"
        return "Integer"
    elif train[col].dtype in ["float64"]:
        return "Float"
    return str(train[col].dtype)

feature_summary = pd.DataFrame({
    "feature": [c for c in train.columns if c not in ["id", "attack_cat", "label"]],
})
feature_summary["inferred_format"] = feature_summary["feature"].apply(infer_format)
print(feature_summary.to_string(index=False))
print("\nTotal features (excluding id, attack_cat, label):", len(feature_summary))
print("Expected from paper Table 2: 42 features (44 total - attack_cat - label)")
</VSCode.Cell>
